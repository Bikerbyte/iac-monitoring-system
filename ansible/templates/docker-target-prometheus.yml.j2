global:
  scrape_interval: 5s
  evaluation_interval: 5s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - iac-lab-prometheus:9090

  - job_name: docker-target-http
    metrics_path: /probe
    params:
      module:
        - http_2xx
    static_configs:
      - targets:
{% for target in iac_docker_target_app_targets %}
          - {{ target }}
{% endfor %}
    relabel_configs:
      - source_labels:
          - __address__
        target_label: __param_target
      - source_labels:
          - __param_target
        target_label: instance
      - target_label: __address__
        replacement: iac-lab-blackbox:9115
