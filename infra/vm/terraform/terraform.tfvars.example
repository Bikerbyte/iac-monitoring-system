# Copy this file to terraform.tfvars for local server or AWS mode overrides.
# Server Agent Mode is the primary VM/Linux monitoring path.
# Docker Target Mode remains available separately as a quick local demo.
# Default mock mode does not create AWS resources.

node_count           = 2
enable_aws_resources = false

server_hosts = [
  {
    name                 = "monitor-node-02"
    ip_address           = "192.168.0.146"
    ansible_user         = "deploy"
    ssh_private_key_file = ""
  },
  {
    name                 = "monitor-node-03"
    ip_address           = "192.168.0.235"
    ansible_user         = "deploy"
    ssh_private_key_file = ""
  }
]

# AWS mode example:
# enable_aws_resources = true
# aws_region           = "ap-northeast-1"
# aws_ami_id           = "ami-xxxxxxxxxxxxxxxxx"
# aws_instance_type    = "t3.micro"
# ansible_user         = "ubuntu"
# ssh_public_key_file  = "~/.ssh/id_rsa.pub"
# ssh_private_key_file = "~/.ssh/id_rsa"
#
# Replace these with your own public IP ranges before creating EC2 instances.
# allowed_ssh_cidr_blocks        = ["203.0.113.10/32"]
# allowed_monitoring_cidr_blocks = ["203.0.113.10/32"]
#
# Monitoring ports used by this project:
# - 3000: Grafana on the control node
# - 8000: Python monitor-agent metrics on target servers
# - 9090: Prometheus on the control node
# - 9093: Alertmanager on the control node
# - 9100: Node Exporter metrics on target servers
