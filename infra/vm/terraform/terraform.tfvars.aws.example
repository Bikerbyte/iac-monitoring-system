# Copy this file to terraform.tfvars.aws before running AWS make targets:
#
#   cp infra/vm/terraform/terraform.tfvars.aws.example infra/vm/terraform/terraform.tfvars.aws
#   make vm-aws-plan
#
# Keep terraform.tfvars.aws local. It may contain your current public IP,
# preferred VPC/subnet, and SSH key paths.

node_count           = 1
enable_aws_resources = true

aws_region        = "ap-northeast-1"
aws_ami_id        = "ami-0555235cac92fff3f" # Ubuntu 24.04 LTS amd64, ap-northeast-1
aws_instance_type = "t3.micro"

ansible_user         = "ubuntu"
ssh_public_key_file  = "~/.ssh/id_rsa.pub"
ssh_private_key_file = "~/.ssh/id_rsa"

# Replace these with your own VPC/subnet before applying.
aws_vpc_id    = "vpc-xxxxxxxxxxxxxxxxx"
aws_subnet_id = "subnet-xxxxxxxxxxxxxxxxx"

# Replace with your current public IP before applying.
# Example:
#   curl -fsS https://checkip.amazonaws.com
allowed_ssh_cidr_blocks        = ["203.0.113.10/32"]
allowed_monitoring_cidr_blocks = ["203.0.113.10/32"] # Grafana 3000, agent 8000, Prometheus 9090, Alertmanager 9093, Node Exporter 9100
